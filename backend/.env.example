# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/shopping-app

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Expiration (e.g., 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies between clients and this server. 0 for local use.
# Set to the verified hop count on your host; never trust arbitrary headers.
TRUST_PROXY_HOPS=0

# Requests per IP per minute. 0 disables limiting (tests only).
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=100

# Enable on exactly one always-running backend instance.
AUTO_COMPLETE_ORDERS_ENABLED=true

# Stripe secrets: backend only. Use test keys for staging.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Cloudinary credentials: backend only.
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
